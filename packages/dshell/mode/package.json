{
  "name": "@deepseek-ai/dsh-dshell-mode",
  "version": "0.1.0",
  "private": true,
  "description": "dshell mode toggle: per-session shell/agent mode state, composer Enter dispatch, /agent and /shell prefix parsing, and agent-mode terminal-context injection.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false && tsdown --config-loader tsx",
    "build:host": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "build:client": "tsdown --config-loader tsx"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../../../dsh/packages/core/agent",
    "@deepseek-ai/dsh-api-session-controller": "link:../../../dsh/packages/api/session-controller",
    "@deepseek-ai/dsh-client-store": "link:../../../dsh/packages/client/store",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../../dsh/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-input-trigger": "link:../../../dsh/packages/client/ui-input-trigger",
    "@deepseek-ai/dsh-client-ui-model-selection": "link:../../../dsh/packages/client/ui-model-selection",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../../dsh/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-settings": "link:../../../dsh/packages/client/ui-settings",
    "@deepseek-ai/dsh-dshell-terminal-bridge": "link:../terminal-bridge",
    "@deepseek-ai/dsh-llm": "link:../../../dsh/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../dsh/packages/core/session",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis"
  }
}
