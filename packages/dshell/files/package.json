{
  "name": "@deepseek-ai/dsh-dshell-files",
  "version": "0.1.0",
  "private": true,
  "description": "dshell file navigator: replaces dsh's right-sidebar Files tab type with a movable browser — a `..` row, clickable path segments, back/forward history over the session's own execution world (a device's whole tree for a device session).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false && tsdown --config-loader tsx",
    "build:host": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "build:client": "tsdown --config-loader tsx"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/protocol.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../../../dsh/packages/core/agent",
    "@deepseek-ai/dsh-api-session-controller": "link:../../../dsh/packages/api/session-controller",
    "@deepseek-ai/dsh-client-connection": "link:../../../dsh/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "link:../../../dsh/packages/client/locale",
    "@deepseek-ai/dsh-client-store": "link:../../../dsh/packages/client/store",
    "@deepseek-ai/dsh-client-ui-dockkit": "link:../../../dsh/packages/client/ui-dockkit",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../../dsh/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../../dsh/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "link:../../../dsh/packages/client/ui-sidebar-right",
    "@deepseek-ai/dsh-client-ui-session": "link:../../../dsh/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../../dsh/packages/client/ui-slots",
    "@deepseek-ai/dsh-fs": "link:../../../dsh/packages/fs/fs",
    "@deepseek-ai/dsh-session": "link:../../../dsh/packages/core/session"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "typescript": "^6.0.3",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis"
  }
}
