{
  "name": "@deepseek-ai/dsh-dshell-ssh",
  "version": "0.1.0",
  "private": true,
  "description": "dshell SSH devices: a durable device/key registry, per-session device binding, and remote execution for a bound session's command tools.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false && tsdown --config-loader tsx",
    "build:host": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "build:client": "tsdown --config-loader tsx"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/protocol.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../../../dsh/packages/core/agent",
    "@deepseek-ai/dsh-client-connection": "link:../../../dsh/packages/client/connection",
    "@deepseek-ai/dsh-client-store": "link:../../../dsh/packages/client/store",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../../dsh/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-settings": "link:../../../dsh/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "link:../../../dsh/packages/client/ui-settings-plugins",
    "@deepseek-ai/dsh-session": "link:../../../dsh/packages/core/session",
    "@deepseek-ai/dsh-settings": "link:../../../dsh/packages/settings/settings",
    "@deepseek-ai/dsh-shell": "link:../../../dsh/packages/shell/shell",
    "@deepseek-ai/dsh-subprocess": "link:../../../dsh/packages/subprocess/subprocess",
    "@deepseek-ai/schemastery": "link:../../../dsh/vendor/schemastery"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "typescript": "^6.0.3",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis"
  }
}
