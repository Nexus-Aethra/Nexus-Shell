{
  "name": "@deepseek-ai/dsh-dshell-bundle",
  "version": "0.1.0",
  "description": "dshell bundle: composition patch layer that wires dshell-* packages into the dsh web profile.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "build:host": "tsc -p tsconfig.json --emitDeclarationOnly false"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/dsh-dshell-buffer": "workspace:^",
    "@deepseek-ai/dsh-dshell-commands": "workspace:^",
    "@deepseek-ai/dsh-dshell-conversation": "workspace:^",
    "@deepseek-ai/dsh-dshell-files": "workspace:^",
    "@deepseek-ai/dsh-dshell-mode": "workspace:^",
    "@deepseek-ai/dsh-dshell-ssh": "workspace:^",
    "@deepseek-ai/dsh-dshell-std": "workspace:^",
    "@deepseek-ai/dsh-dshell-terminal-bridge": "workspace:^",
    "@deepseek-ai/dsh-dshell-workspace": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox-local": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.5-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.1.5-rc.1",
    "@deepseek-ai/dsh-terminal": "0.1.5-rc.1",
    "@deepseek-ai/dsh-terminal-bash": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tool-terminal": "0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox-local": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.5-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.1.5-rc.1",
    "@deepseek-ai/dsh-terminal": "0.1.5-rc.1",
    "@deepseek-ai/dsh-terminal-bash": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tool-terminal": "0.1.5-rc.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
