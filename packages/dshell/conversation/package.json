{
  "name": "@deepseek-ai/dsh-dshell-conversation",
  "version": "0.1.0",
  "private": true,
  "description": "dshell Conversation activity marker: registers an always-active `terminal` view target so the conversation stays in active phase and the docked terminal surface renders instead of the centered hero.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false && tsdown --config-loader tsx",
    "build:host": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "build:client": "tsdown --config-loader tsx"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/**/*.css"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis",
    "@deepseek-ai/dsh-api-session-controller": "link:../../../dsh/packages/api/session-controller",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../../dsh/packages/client/ui-conversation"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis"
  }
}
