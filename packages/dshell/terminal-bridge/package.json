{
  "name": "@deepseek-ai/dsh-dshell-terminal-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "dshell terminal bridge: owns the bridge-named `main` PTY per session through its raw node-pty backend (registered as the default `shell` type, so persistent shell tools land here without preset config), exposes /dshell/pty ws upgrade route, and hosts the PtyBuffer service consumed by dshell-mode and dshell-commands.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false && tsdown --config-loader tsx",
    "build:host": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "build:client": "tsdown --config-loader tsx"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../../../dsh/packages/core/agent",
    "@deepseek-ai/dsh-api-session-controller": "link:../../../dsh/packages/api/session-controller",
    "@deepseek-ai/dsh-client-connection": "link:../../../dsh/packages/client/connection",
    "@deepseek-ai/dsh-client-store": "link:../../../dsh/packages/client/store",
    "@deepseek-ai/dsh-host-webserver": "link:../../../dsh/packages/host/webserver",
    "@deepseek-ai/dsh-session": "link:../../../dsh/packages/core/session",
    "@deepseek-ai/dsh-terminal": "link:../../../dsh/packages/terminal/terminal",
    "node-pty": "link:../../../dsh/node_modules/.pnpm/node-pty@1.2.0-beta.15/node_modules/node-pty",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/ws": "^8.5.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis"
  }
}
