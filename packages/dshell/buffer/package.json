{
  "name": "@deepseek-ai/dsh-dshell-buffer",
  "version": "0.1.0",
  "private": true,
  "description": "dshell cross-session buffer: user-established links between sessions, deferred requests one agent hands to another, a durable ticket queue with progress reports, scoped revocable folder grants, and a watchdog that guarantees the requester is always woken with an outcome.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false && tsdown --config-loader tsx",
    "build:host": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "build:client": "tsdown --config-loader tsx"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/protocol.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../../../dsh/packages/core/agent",
    "@deepseek-ai/dsh-api-session-controller": "link:../../../dsh/packages/api/session-controller",
    "@deepseek-ai/dsh-client-connection": "link:../../../dsh/packages/client/connection",
    "@deepseek-ai/dsh-client-ui-layout": "link:../../../dsh/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../../dsh/packages/client/ui-renderer",
    "@deepseek-ai/dsh-fs": "link:../../../dsh/packages/fs/fs",
    "@deepseek-ai/dsh-llm": "link:../../../dsh/packages/llm/llm",
    "@deepseek-ai/dsh-sandbox-policy": "link:../../../dsh/packages/sandbox/sandbox-policy",
    "@deepseek-ai/dsh-session": "link:../../../dsh/packages/core/session",
    "@deepseek-ai/dsh-system-prompt": "link:../../../dsh/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../../../dsh/packages/core/tools"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "typescript": "^6.0.3",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis"
  }
}
