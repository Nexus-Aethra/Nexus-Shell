{
  "name": "@deepseek-ai/dsh-dshell-commands",
  "version": "0.1.0",
  "private": true,
  "description": "dshell commands and tools: /clear, /new, /compact on ctx.commands, plus the model-facing dshell_get_main_terminal tool that returns the bridge's main PTY id.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "build:host": "tsc -p tsconfig.json --emitDeclarationOnly false"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis",
    "@deepseek-ai/dsh-api-session-controller": "link:../../../dsh/packages/api/session-controller",
    "@deepseek-ai/dsh-commands": "link:../../../dsh/packages/interaction/commands",
    "@deepseek-ai/dsh-dshell-terminal-bridge": "link:../terminal-bridge",
    "@deepseek-ai/dsh-llm": "link:../../../dsh/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../dsh/packages/core/session",
    "@deepseek-ai/dsh-tools": "link:../../../dsh/packages/core/tools"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh/vendor/cordis"
  }
}
